PORT=3000
# Supabase project settings. The app derives a TLS Postgres URL from these.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PASSWORD=
# Preferred: copy the Session pooler URI from Supabase > Connect and replace
# [YOUR-PASSWORD]. If set, it takes precedence over the separate values below.
SUPABASE_DATABASE_URL=
# Copy the session-pooler host/port from Supabase > Connect. This endpoint is
# IPv4-compatible, unlike the direct database hostname on many projects.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
# Optional local-development fallback when Supabase values are absent.
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
PUBLIC_URL=http://localhost:3000
WORKSPACE_ROOT=.relay/workspaces
AGENT_IMAGE=relay-agent:latest
# Maximum concurrent runs in the default Compose deployment.
WORKER_REPLICAS=3
# Used to mint one-run credentials. Generate with: openssl rand -hex 32
MASTER_KEY=replace-me-with-at-least-32-random-characters
# Optional. Empty uses the Codex CLI's current default coding model.
CODEX_MODEL=
# Create an OAuth App at github.com/settings/developers. Callback URL:
# http://localhost:3000/api/connections/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GIT_HOSTS=github.com,gitlab.com
