# Public origin used by GitHub OAuth redirects.
PUBLIC_URL=http://localhost:3000

# Supabase Session pooler URI from Supabase > Connect.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres

# Generate with: openssl rand -hex 32
MASTER_KEY=

# GitHub OAuth App credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
