{
  "name": "relay-cloud-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A durable cloud coding agent with isolated per-run containers",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/api.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api.js",
    "worker": "node dist/worker.js",
    "db:migrate": "tsx src/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@fastify/static": "^10.1.0",
    "dockerode": "^5.0.1",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.42",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
